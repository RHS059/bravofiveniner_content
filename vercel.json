{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/BravoFiveNine.dc.html" },
    { "source": "/mods/:path*", "destination": "/public/mods/:path*" },
    { "source": "/mod/:id", "destination": "/Mod%20Page.dc.html?id=:id" }
  ],
  "headers": [
    {
      "source": "/mods/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/data/mods.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
